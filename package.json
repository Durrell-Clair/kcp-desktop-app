{
  "name": "kamer-kash-pme-electron",
  "version": "1.0.0",
  "description": "KAMER KASH PME Desktop Application",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc && npm run copy-migrations && cross-env NODE_ENV=development electron .",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run build -- --win",
    "build:win:local": "npm run compile && electron-builder --win --publish never",
    "build:win:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run compile && electron-builder --win --publish never",
    "release:github": "python scripts/create-release-github.py",
    "start": "electron .",
    "compile": "tsc && npm run copy-migrations",
    "copy-migrations": "node scripts/copy-migrations.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.2.2",
    "bonjour": "^3.5.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bonjour": "^3.5.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kamercashpme.desktop",
    "productName": "KAMER KASH PME",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "KAMER KASH PME"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Durrell-Clair",
      "repo": "kcp-desktop-app"
    }
  }
}
